# Local Docker development. Copy this file to .env before `docker compose up --build`.
# .env is not committed. docker-compose.yml only references these names.

POSTGRES_USER=agentops
POSTGRES_PASSWORD=agentops
POSTGRES_DB=agentops
POSTGRES_PORT=5432

REDIS_PORT=6379

# At least 32 characters. Replace this local placeholder before sharing a deployment.
JWT_SECRET=local-docker-development-jwt-secret

# Optional. Chat can call the model only when this is set.
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4o-mini
# Leave empty to run without document embeddings.
EMBEDDING_MODEL=

# Browser origin for the published frontend port.
CORS_ORIGINS=http://localhost:5173
FRONTEND_PORT=5173
BACKEND_PORT=8000
