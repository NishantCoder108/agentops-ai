APP_NAME="AgentOps AI"

# development | production
ENVIRONMENT=development

# Must be false in production
DEBUG=false

API_V1_PREFIX=/api/v1

# Comma-separated list of allowed browser origins ("*" is rejected in production)
CORS_ORIGINS=http://localhost:5173

# --- LLM ---
# Supported: openrouter
LLM_PROVIDER=openrouter
# Model identifier as understood by the provider, e.g. an OpenRouter model slug
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# OpenRouter (https://openrouter.ai/keys). Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding model for document search. Leave empty to run without the knowledge tool.
# Must return 1536-dimension vectors (for example openai/text-embedding-3-small).
EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Database ---
# Async SQLAlchemy URL; must use the postgresql+asyncpg:// driver.
# Matches the local docker-compose.yml defaults. Leave empty to run the app without a database.
DATABASE_URL=postgresql+asyncpg://agentops:agentops@localhost:5432/agentops
# Log every SQL statement (development only)
DATABASE_ECHO=false

# Database used by pytest. It is wiped on every test run, so it must be a dedicated *_test database.
TEST_DATABASE_URL=postgresql+asyncpg://agentops:agentops@localhost:5432/agentops_test

# HS256 signing key for access tokens. At least 32 characters. Required in production.
JWT_SECRET=
# Access token lifetime in minutes (1-1440)
JWT_ACCESS_TOKEN_MINUTES=60

# Unused. The authenticated user's organization scopes documents, chat, and analytics.
DEFAULT_ORGANIZATION_ID=

# --- Redis ---
# Shared chat rate-limit counters (INCR + expiry). Leave empty in local development:
# the app then keeps the same limit in memory. Required in production.
# Set this when the docker-compose Redis service is running.
REDIS_URL=
# Requests per user per window. POST /chat and POST /chat/stream share this budget.
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
