APP_NAME="AgentOps AI"

# development | production
ENVIRONMENT=development

# Must be false in production
DEBUG=false

API_V1_PREFIX=/api/v1

# Comma-separated list of allowed browser origins ("*" is rejected in production)
CORS_ORIGINS=http://localhost:5173

# --- LLM ---
# Supported: openrouter
LLM_PROVIDER=openrouter
# Model identifier as understood by the provider, e.g. an OpenRouter model slug
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# OpenRouter (https://openrouter.ai/keys). Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
